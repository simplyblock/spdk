# syntax=docker/dockerfile:1
# push to "simplyblock/spdk-core:base_image"

ARG UBI_VERSION=10.2

FROM registry.access.redhat.com/ubi10/ubi:${UBI_VERSION}

ARG OPENSSL_VERSION=3.5.8

USER root

WORKDIR /root

# UBI's own repos only carry a trimmed subset of RHEL packages, so pull in EPEL
# and CentOS Stream (binary-compatible, freely redistributable) for the rest
# (parted, xfsprogs, nvme-cli, fio, perftest, etc.). CentOS Stream is left
# disabled by default and only enabled for the one install below that needs
# it, so it never gets picked over UBI's own build of a shared package (which
# previously caused dnf upgrade conflicts, e.g. on gcc).
RUN dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm && \
    printf '%s\n' \
    '[cs10-baseos]' \
    'name=CentOS Stream 10 - BaseOS' \
    'baseurl=https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/os/' \
    'enabled=0' \
    'gpgcheck=1' \
    'gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256' \
    '' \
    '[cs10-appstream]' \
    'name=CentOS Stream 10 - AppStream' \
    'baseurl=https://mirror.stream.centos.org/10-stream/AppStream/x86_64/os/' \
    'enabled=0' \
    'gpgcheck=1' \
    'gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256' \
    > /etc/yum.repos.d/centos-stream.repo

RUN dnf install -y --enablerepo=cs10-baseos --enablerepo=cs10-appstream \
    git diffutils procps-ng pip kmod hostname wget pkg-config cmake nano systemd-udev openldap-clients  \
    dosfstools ntfsprogs e2fsprogs ntfs-* gdb parted fio xfsprogs libasan libubsan python3 python3-pip  \
    nvme-cli librdmacm-utils perftest numactl gdisk

RUN rm -f /etc/yum.repos.d/centos-stream.repo && dnf clean all

COPY ./ /root/spdk/

RUN cd spdk && scripts/pkgdep.sh --rdma --pmem

RUN rm -rf /root/spdk

# Build OpenSSL (bump OPENSSL_VERSION above to pick up CVE fixes)
RUN dnf update -y && dnf upgrade -y && \
    dnf install -y zlib-devel make gcc perl curl \
    libcurl-devel libuuid-devel && \
    wget https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz && \
    tar -xvf openssl-${OPENSSL_VERSION}.tar.gz && \
    cd openssl-${OPENSSL_VERSION} && \
    ./config && make -j"$(nproc)" && make install && \
    echo /usr/local/lib64 > /etc/ld.so.conf.d/openssl.conf && ldconfig && \
    cd .. && rm -rf openssl-${OPENSSL_VERSION}*

# Clone + build AWS SDK
RUN git clone --recurse-submodules https://github.com/simplyblock-io/aws-sdk-cpp && \
    touch aws-sdk-cpp/crt/aws-crt-cpp/include/aws/crt/pthread_utils.h && \
    cp aws-sdk-cpp/pthread_utils.txt aws-sdk-cpp/crt/aws-crt-cpp/include/aws/crt/pthread_utils.h && \
    mkdir -p aws-sdk-cpp/sdk_build && \
    cd aws-sdk-cpp/sdk_build && \
    cmake ../ -DCMAKE_BUILD_TYPE=Debug \
    -DBUILD_SHARED_LIBS=OFF \
    -DFORCE_SHARED_CRT=OFF \
    -DUSE_CRT_HTTP_CLIENT=ON \
    -DCMAKE_PREFIX_PATH=/usr/local/ \
    -DCMAKE_INSTALL_PREFIX=/usr/local/ \
    -DENABLE_TESTING=OFF \
    -DBUILD_ONLY="s3;s3-crt" && \
    make -j"$(nproc)" && make install
